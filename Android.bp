java_library {
    name: "jipp",
    host_supported: true,
    sdk_version: "core_current",
    visibility: [
        "//vendor:__subpackages__",
    ],
    srcs: [
        "jipp-core/src/main/java/**/*.java",
        "jipp-core/src/main/java/**/*.kt",
        "jipp-pdl/src/main/kotlin/**/*.kt",
    ],
}

java_library {
    name: "jipp-test-util",
    host_supported: true,
    sdk_version: "core_current",
    visibility: [
        "//vendor:__subpackages__",
    ],
    srcs: [
        "jipp-pdl/src/test/kotlin/util/*.kt",
    ],
    exclude_srcs: [
        "jipp-pdl/src/test/kotlin/util/KotlinTest.kt",
    ],
    static_libs: [
        "jipp",
    ],
    test_only: true,
}
